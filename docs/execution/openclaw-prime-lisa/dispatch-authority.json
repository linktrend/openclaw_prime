    "modelCount": 36,
    "autoSmartPresent": false,
    "optimizeForCostPresent": false,
    "genericAutoOnly": true
  },
  "dispatchMechanism": {
    "backend": "cursor-sdk",
    "sdkLanguage": "python",
    "catalogueMethod": "Cursor.models.list",
    "catalogueReadbackState": "VERIFIED_AUTO_COST_UNAVAILABLE_FIXED_MODELS_REQUIRED",
    "selectorReadback": "run.model-and-result.model",
    "optimizationModeReadback": "result.model.params.optimize_for",
    "effectiveModelReadback": "cloud-agent-metadata:/v1/meta-data/turn/model",
    "intentStateBeforeApi": "PREPARED",
    "intentReadbackRequired": true,
    "acceptedDispatchReadbackRequired": true,
    "cursorDesktopAgentFilesRequired": false,
    "cloudApiV1AutoCostAllowed": false,
    "fastMode": "disabled",
    "forbiddenAutoSubstitutes": ["auto", "auto-balance", "auto-intelligence", "omitted-model", "unverifiable-auto"]
  },
  "validationPolicy": {
    "id": "openclaw-fork-progressive-validation-v1",
    "digest": "sha256:445953e776fa6594bc96f047794616164ec75b213a07c0e9300630db1ec24a17",
    "mode": "fork-progressive",
    "baselineFullSuite": { "requiredBeforePacketStart": false, "receiptRequired": true, "inheritUnchangedFailures": true },
    "packetValidation": { "profile": "focused", "ownedPathsAndDeclaredContractsOnly": true },
    "phaseValidation": {
      "requiredProfiles": ["fast", "change-scoped-integration-contract"],
      "repositoryWideFullRequired": false,
      "customizationScope": "exact-normalized-protected-base-to-phase-diff",
      "staticProvenanceMayDescribeInventory": true,
      "staticProvenanceExcludesProvenPhasePath": false,
      "untouchedUpstream": "files-outside-exact-diff"
    },
    "releaseCandidateValidation": { "repositoryWideFullRequired": false, "customizationScopedFullRequired": true, "rollbackRecoveryProofRequired": true, "before": ["staging", "promotion"] },
    "blocking": { "changedPathOrCrossContractFailure": true, "waiveChangedCode": false },
    "provider": { "centralIdeProviderFullRequired": true },
    "scope": { "forkOnly": true, "upstreamMutation": false }
  },
  "dispatchPolicy": {
    "manifestTargetReleaseMustMatchAuthorityId": true,
    "manifestDigestMustMatch": true,
    "routingMatrixDigestMustMatch": true,
    "failClosedOnMissingPrerequisite": true,
    "failClosedOnMissingRoute": true,
    "failClosedOnMissingCatalogueOrReadback": true,
    "requireExecutionApprovalSnapshot": true,
    "prerequisiteEvidenceSource": "runtime-authority-snapshot",
    "dispatchIntentMustCarryRoute": true,
    "modelQualityFallbackRequiresLoggedFailure": true,
    "modelQualityFallbackMaximumHops": 1,
    "infrastructureFailureChangesModel": false,
    "independentReviewUsesSeparateWorker": true,
    "terraCheckpointVerificationIsDistinct": true,
    "failClosedOnMissingProgramRunIdentityBinding": true,
    "capabilityPreflightCadence": "once-per-program-run"
  },
  "routeCatalog": {
    "auto_cost": {
      "transport": "cursor-sdk",
      "selector": {
        "modelId": "auto-smart",
        "params": [{ "id": "optimize_for", "value": "cost" }]
      },
      "fast": false,
      "purpose": "preferred automatic cost-optimized route for bounded normal work",
      "costPool": "auto-cost-bundled",
      "fallbackPolicy": "auto_cost_effective_family_one_hop"
    },
    "composer_bounded": {
      "transport": "cursor-sdk",
      "selector": { "modelId": "composer-2.5", "params": [] },
      "fast": false,
      "purpose": "fully bounded simple, repetitive, objectively verified, reversible work",
      "costPool": "cursor-models",
      "fallbackPolicy": "composer_to_grok_one_hop"
    },
    "grok_complex": {
      "transport": "cursor-sdk",
      "selector": { "modelId": "cursor-grok-4.6-medium", "params": [] },
      "fast": false,
      "purpose": "explicit complex or long-running work",
      "costPool": "cursor-models",
      "fallbackPolicy": "grok_to_composer_one_hop"
    },
    "independent_review": {
      "transport": "cursor-sdk",
      "selector": { "modelId": "claude-opus-4-8-thinking-medium", "params": [] },
      "fast": false,
      "purpose": "separate consequential security, authorization, migration, infrastructure, or final integration review",
      "costPool": "other-models",
      "fallbackPolicy": null
    },
    "independent_terra_verification": {
      "transport": "cursor-sdk",
      "selector": { "modelId": "gpt-5.6-terra-high", "params": [] },
      "fast": false,
      "purpose": "independent IDE v2.5.1 Issue-checkpoint verification bound to the exact candidate",
      "costPool": "other-models",
      "fallbackPolicy": null
    }
  },
  "fallbackPolicies": {
    "auto_cost_effective_family_one_hop": {
      "trigger": "logged-model-quality-failure-only",
      "maximumHops": 1,
      "differentFamilySelection": {
        "whenEffectiveFamilyIsGrokOrXai": "composer_bounded",
        "otherwise": "grok_complex"
      },
      "infrastructureFailureAction": "same-model-retry-under-protocol"
    },
    "composer_to_grok_one_hop": {
      "trigger": "logged-model-quality-failure-only",
      "maximumHops": 1,
      "fallbackRoute": "grok_complex",
      "infrastructureFailureAction": "same-model-retry-under-protocol"
    },
    "grok_to_composer_one_hop": {
      "trigger": "logged-model-quality-failure-only",
      "maximumHops": 1,
      "fallbackRoute": "composer_bounded",
      "infrastructureFailureAction": "same-model-retry-under-protocol"
    }
  },
