      "missingOrFailedClassification": "WAIVED_LEGACY_GATE"
    },
    "autoworkDiscovery": {"requiredWhenCallable": true, "unavailableIsHold": true},
    "issueCheckpoint": {
      "acceptWithoutReviewReady": true,
      "acceptWithoutToken": true,
      "requiredEvidence": ["exact_pushed_commit_tree", "scoped_diff", "focused_tests", "independent_narrow_review", "manifest_evidence"]
    },
    "administratorRecovery": {
      "namedExceptionOnly": true,
      "afterReplacementProof": true,
      "allowedOperations": ["protection_snapshot", "restore", "readback"]
    },
    "durableHeartbeat": {"writeReadbackRequired": true, "persistBeforeMutation": true},
    "checkoutBoundVerification": {"bindToCheckout": true, "forbidMergeRefIdentity": true},
    "retryExhaustion": {
      "diagnoseBeforeRecovery": true,
      "forbidSilentRetry": true,
      "ordinaryRecovery": "new_identity",
      "infrastructureRecovery": "hold",
      "codeFailureRecovery": "new_identity"
    },
    "hostedCapacityScheduler": {
      "requireCompleteSnapshot": true,
      "busyIsNotDiagnosis": true,
      "unknownIsBlocking": true,
      "hostedConcurrencyAuthority": "execution-protocol",
      "maxAdmittedSlots": {"local": 1},
      "adaptiveConcurrency": {
        "mode": "minimum_of_live_evidence",
        "capacityEvidence": "authenticated_cursor_account",
        "identityFields": ["accountId", "apiKeyName", "teamId", "programRunId"],
        "spendCeilingEvidence": "required",
        "safetyConstraintEvidence": "required",
        "evidenceMaxAgeSeconds": 3600
      },
      "unknownProbeSeconds": 600,
      "backstopSeconds": 600,
      "prioritization": ["priority", "dependencyReady", "fifo"],
      "utilizationGapEvent": "UTILIZATION_GAP",
      "recomputeOnEvents": ["admission", "completion", "invalidation", "probe_timeout", "api_rejection", "utilization_gap_repair"]
    }
