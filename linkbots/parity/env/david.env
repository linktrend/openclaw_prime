# Non-secret source template. Deployment injects private values through SecretRefs.
HOME=/var/lib/openclaw/david
OPENCLAW_CONFIG_PATH=/var/lib/openclaw/david/.openclaw-david/openclaw.json
OPENCLAW_GATEWAY_PORT=18793
OPENCLAW_NO_RESPAWN=1
OPENCLAW_PROFILE=david
OPENCLAW_STATE_DIR=/var/lib/openclaw/david/.openclaw-david
PLATFORM_ACTOR_REF=__SECRET_REF_PLATFORM_ACTOR_DAVID__
PLATFORM_RUNTIME_BINDING_REF=__SECRET_REF_PLATFORM_RUNTIME_DAVID__
BRAIN_CREDENTIAL_REF=__SECRET_REF_BRAIN_CREDENTIAL_DAVID__
BRAIN_CLIENT_REF=__SECRET_REF_BRAIN_CLIENT_DAVID__
BRAIN_KEY_REF=__SECRET_REF_BRAIN_KEY_DAVID__
SKILLS_CREDENTIAL_REF=__SECRET_REF_SKILLS_CREDENTIAL_DAVID__
SKILLS_CLIENT_REF=__SECRET_REF_SKILLS_CLIENT_DAVID__
SKILLS_KEY_REF=__SECRET_REF_SKILLS_KEY_DAVID__
GOOGLE_CHAT_ACTIVATION_GATE=disabled-until-secretref
GOOGLE_CHAT_SERVICE_ACCOUNT_REF=__SECRET_REF_GOOGLECHAT_SERVICE_ACCOUNT_DAVID__
