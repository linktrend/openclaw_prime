# Non-secret source template. Deployment injects private values through SecretRefs.
HOME=/var/lib/openclaw/sara
OPENCLAW_CONFIG_PATH=/var/lib/openclaw/sara/.openclaw-sara/openclaw.json
OPENCLAW_GATEWAY_PORT=18794
OPENCLAW_NO_RESPAWN=1
OPENCLAW_PROFILE=sara
OPENCLAW_STATE_DIR=/var/lib/openclaw/sara/.openclaw-sara
PLATFORM_ACTOR_REF=__SECRET_REF_PLATFORM_ACTOR_SARA__
PLATFORM_RUNTIME_BINDING_REF=__SECRET_REF_PLATFORM_RUNTIME_SARA__
BRAIN_CREDENTIAL_REF=__SECRET_REF_BRAIN_CREDENTIAL_SARA__
BRAIN_CLIENT_REF=__SECRET_REF_BRAIN_CLIENT_SARA__
BRAIN_KEY_REF=__SECRET_REF_BRAIN_KEY_SARA__
SKILLS_CREDENTIAL_REF=__SECRET_REF_SKILLS_CREDENTIAL_SARA__
SKILLS_CLIENT_REF=__SECRET_REF_SKILLS_CLIENT_SARA__
SKILLS_KEY_REF=__SECRET_REF_SKILLS_KEY_SARA__
GOOGLE_CHAT_ACTIVATION_GATE=disabled-until-secretref
GOOGLE_CHAT_SERVICE_ACCOUNT_REF=__SECRET_REF_GOOGLECHAT_SERVICE_ACCOUNT_SARA__
