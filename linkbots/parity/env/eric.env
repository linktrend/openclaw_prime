# Non-secret source template. Deployment injects private values through SecretRefs.
HOME=/var/lib/openclaw/eric
OPENCLAW_CONFIG_PATH=/var/lib/openclaw/eric/.openclaw-eric/openclaw.json
OPENCLAW_GATEWAY_PORT=18792
OPENCLAW_NO_RESPAWN=1
OPENCLAW_PROFILE=eric
OPENCLAW_STATE_DIR=/var/lib/openclaw/eric/.openclaw-eric
PLATFORM_ACTOR_REF=__SECRET_REF_PLATFORM_ACTOR_ERIC__
PLATFORM_RUNTIME_BINDING_REF=__SECRET_REF_PLATFORM_RUNTIME_ERIC__
BRAIN_CREDENTIAL_REF=__SECRET_REF_BRAIN_CREDENTIAL_ERIC__
BRAIN_CLIENT_REF=__SECRET_REF_BRAIN_CLIENT_ERIC__
BRAIN_KEY_REF=__SECRET_REF_BRAIN_KEY_ERIC__
SKILLS_CREDENTIAL_REF=__SECRET_REF_SKILLS_CREDENTIAL_ERIC__
SKILLS_CLIENT_REF=__SECRET_REF_SKILLS_CLIENT_ERIC__
SKILLS_KEY_REF=__SECRET_REF_SKILLS_KEY_ERIC__
GOOGLE_CHAT_ACTIVATION_GATE=disabled-until-secretref
GOOGLE_CHAT_SERVICE_ACCOUNT_REF=__SECRET_REF_GOOGLECHAT_SERVICE_ACCOUNT_ERIC__
