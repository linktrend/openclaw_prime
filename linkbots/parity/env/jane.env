# Non-secret source template. Deployment injects private values through SecretRefs.
HOME=/var/lib/openclaw/jane
OPENCLAW_CONFIG_PATH=/var/lib/openclaw/jane/.openclaw-jane/openclaw.json
OPENCLAW_GATEWAY_PORT=18795
OPENCLAW_NO_RESPAWN=1
OPENCLAW_PROFILE=jane
OPENCLAW_STATE_DIR=/var/lib/openclaw/jane/.openclaw-jane
PLATFORM_ACTOR_REF=__SECRET_REF_PLATFORM_ACTOR_JANE__
PLATFORM_RUNTIME_BINDING_REF=__SECRET_REF_PLATFORM_RUNTIME_JANE__
BRAIN_CREDENTIAL_REF=__SECRET_REF_BRAIN_CREDENTIAL_JANE__
BRAIN_CLIENT_REF=__SECRET_REF_BRAIN_CLIENT_JANE__
BRAIN_KEY_REF=__SECRET_REF_BRAIN_KEY_JANE__
SKILLS_CREDENTIAL_REF=__SECRET_REF_SKILLS_CREDENTIAL_JANE__
SKILLS_CLIENT_REF=__SECRET_REF_SKILLS_CLIENT_JANE__
SKILLS_KEY_REF=__SECRET_REF_SKILLS_KEY_JANE__
GOOGLE_CHAT_ACTIVATION_GATE=disabled-until-secretref
GOOGLE_CHAT_SERVICE_ACCOUNT_REF=__SECRET_REF_GOOGLECHAT_SERVICE_ACCOUNT_JANE__
