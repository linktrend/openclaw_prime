# Non-secret source template. Deployment injects private values through SecretRefs.
HOME=/var/lib/openclaw/lisa
OPENCLAW_CONFIG_PATH=/var/lib/openclaw/lisa/.openclaw-lisa/openclaw.json
OPENCLAW_GATEWAY_PORT=18791
OPENCLAW_NO_RESPAWN=1
OPENCLAW_PROFILE=lisa
OPENCLAW_STATE_DIR=/var/lib/openclaw/lisa/.openclaw-lisa
PLATFORM_ACTOR_REF=__SECRET_REF_PLATFORM_ACTOR_LISA__
PLATFORM_RUNTIME_BINDING_REF=__SECRET_REF_PLATFORM_RUNTIME_LISA__
BRAIN_CREDENTIAL_REF=__SECRET_REF_BRAIN_CREDENTIAL_LISA__
BRAIN_CLIENT_REF=__SECRET_REF_BRAIN_CLIENT_LISA__
BRAIN_KEY_REF=__SECRET_REF_BRAIN_KEY_LISA__
SKILLS_CREDENTIAL_REF=__SECRET_REF_SKILLS_CREDENTIAL_LISA__
SKILLS_CLIENT_REF=__SECRET_REF_SKILLS_CLIENT_LISA__
SKILLS_KEY_REF=__SECRET_REF_SKILLS_KEY_LISA__
GOOGLE_CHAT_ACTIVATION_GATE=disabled-until-secretref
GOOGLE_CHAT_SERVICE_ACCOUNT_REF=__SECRET_REF_GOOGLECHAT_SERVICE_ACCOUNT_LISA__
